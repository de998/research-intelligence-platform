research_intelligence:
  target: dev
  outputs:
    dev:
      type: postgres
      host: "{{ env_var('PGHOST', 'localhost') }}"
      port: "{{ env_var('PGPORT', '5432') | int }}"
      user: "{{ env_var('PGUSER') }}"
      password: "{{ env_var('DBT_ENV_SECRET_RESEARCH_PASSWORD') }}"
      dbname: "{{ env_var('PGDATABASE', 'research_demo') }}"
      schema: core
      threads: 4
